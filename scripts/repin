#!/usr/bin/env python3
"""Repin a plugin in ALL marketplace manifests atomically.

The repo carries three files — .claude-plugin/marketplace.json (Claude Code
schema, has version fields), .agents/plugins/marketplace.json (Codex schema,
sha only), and .agents/plugins/plugin-versions.json (the version companion
to the Codex manifest). Updating one and not the others ships stale plugins
to one harness fleet-wide, or leaves the version companion lying; this
script makes that impossible.

Usage:
  scripts/repin NAME SHA [VERSION]   update NAME's sha (and version) in all
  scripts/repin --all                detect each sha-pinned plugin's latest
                                     remote main sha + version and repin all
  scripts/repin check                verify all three files agree
  scripts/repin selftest             prove a repin is all-or-nothing
"""
import datetime
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANIFESTS = [
    (ROOT / ".claude-plugin/marketplace.json", True),   # (path, has version field)
    (ROOT / ".agents/plugins/marketplace.json", False),
]
VERSIONS = ROOT / ".agents/plugins/plugin-versions.json"


def load(path):
    return json.loads(path.read_text())


def save(path, data):
    path.write_text(json.dumps(data, indent=2) + "\n")


def shas(path):
    return {p["name"]: p["source"].get("sha") for p in load(path)["plugins"]}


def versions(path):
    return {p["name"]: p.get("version") for p in load(path)["plugins"]}


def check():
    a, b = (shas(p) for p, _ in MANIFESTS)
    drift = [f"{n}: claude={a[n]} codex={b[n]}" for n in sorted(a.keys() & b.keys()) if a[n] != b[n]]

    declared, pinned = versions(MANIFESTS[0][0]), versions(VERSIONS)
    drift += [
        f"{n}: marketplace={declared[n]} plugin-versions={pinned[n]}"
        for n in sorted(declared.keys() & pinned.keys())
        if declared[n] != pinned[n]
    ]
    drift += [f"{n}: missing from plugin-versions.json" for n in sorted(declared.keys() - pinned.keys())]

    for line in drift:
        print(f"DRIFT {line}")
    if drift:
        sys.exit(1)
    print(f"ok: {len(a.keys() & b.keys())} shared plugins agree on sha and version")


def repin(name, sha, version):
    if len(sha) != 40:
        sys.exit(f"error: expected a full 40-char sha, got {sha!r}")

    # Stage every file in memory and validate ALL of them before writing ANY.
    # A missing entry or an unpinned source in a later file must abort before
    # the first save() — otherwise one manifest lands updated while another is
    # left behind, the exact "stale plugin to one harness fleet-wide" split the
    # docstring promises is impossible. Nothing touches disk until the whole
    # catalog is proven repinnable.
    staged = []  # list of (path, data, message), written only if all validate
    for path, has_version in MANIFESTS:
        data = load(path)
        entry = next((p for p in data["plugins"] if p["name"] == name), None)
        if entry is None:
            sys.exit(f"error: {name} not in {path.relative_to(ROOT)}")
        if "sha" not in entry["source"]:
            sys.exit(f"error: {name} in {path.relative_to(ROOT)} is not sha-pinned")
        entry["source"]["sha"] = sha
        message = f"{path.relative_to(ROOT)}: {name} -> {sha}"
        if has_version and version:
            entry["version"] = version
            message += f" ({version})"
        staged.append((path, data, message))
    if version:
        data = load(VERSIONS)
        entry = next((p for p in data["plugins"] if p["name"] == name), None)
        if entry is None:
            sys.exit(f"error: {name} not in {VERSIONS.relative_to(ROOT)}")
        entry["version"] = version
        data["generatedAt"] = datetime.date.today().isoformat()
        staged.append((VERSIONS, data, f"{VERSIONS.relative_to(ROOT)}: {name} -> {version}"))

    for path, data, message in staged:
        save(path, data)
        print(message)
    check()


def _gh(endpoint, *extra):
    """Raw text from `gh api`. Fails the run on any error — a repin built on a
    half-fetched catalog is worse than no repin."""
    result = subprocess.run(
        ["gh", "api", endpoint, *extra], capture_output=True, text=True
    )
    if result.returncode != 0:
        sys.exit(f"error: gh api {endpoint} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def _repo(url):  # https://github.com/OWNER/REPO.git -> OWNER/REPO
    return url.rsplit("github.com/", 1)[1].removesuffix(".git")


def repin_all():
    """Quick post-merge repin: for every sha-pinned plugin, read the latest
    remote main sha and the version its plugin.json declares there, then repin
    all of them. Floating plugins (no source.sha) have no sha to detect and are
    left untouched. Every fetch happens BEFORE any write, so a network failure
    mid-catalog cannot leave a partially-repinned marketplace."""
    catalog = load(MANIFESTS[0][0])["plugins"]
    targets, skipped = [], []
    for plugin in catalog:
        name, src = plugin["name"], plugin["source"]
        if "sha" not in src or "url" not in src:
            skipped.append(name)
            continue
        repo = _repo(src["url"])
        sha = _gh(f"repos/{repo}/commits/main", "--jq", ".sha")
        prefix = f"{src['path']}/" if src.get("path") else ""
        manifest = _gh(
            f"repos/{repo}/contents/{prefix}.claude-plugin/plugin.json?ref={sha}",
            "-H", "Accept: application/vnd.github.raw",
        )
        targets.append((name, sha, json.loads(manifest)["version"]))
    if not targets:
        sys.exit("error: no sha-pinned plugins to repin")
    for name, sha, version in targets:
        repin(name, sha, version)
    for name in skipped:
        print(f"skip {name}: floating ref, no sha to pin")


def selftest():
    """Prove repin refuses a partial catalog without leaving a partial write."""
    import shutil
    import tempfile

    global MANIFESTS, VERSIONS, ROOT
    saved = (MANIFESTS, VERSIONS, ROOT)
    tmp = Path(tempfile.mkdtemp())
    old, new = "0" * 40, "1" * 40
    try:
        claude = tmp / ".claude-plugin/marketplace.json"
        codex = tmp / ".agents/plugins/marketplace.json"
        vers = tmp / ".agents/plugins/plugin-versions.json"
        for p in (claude, codex, vers):
            p.parent.mkdir(parents=True, exist_ok=True)
        claude.write_text(json.dumps({"plugins": [{"name": "alpha", "source": {"sha": old}, "version": "1.0.0"}]}) + "\n")
        codex.write_text(json.dumps({"plugins": []}) + "\n")  # alpha MISSING -> second manifest fails
        vers.write_text(json.dumps({"plugins": [{"name": "alpha", "version": "1.0.0"}]}) + "\n")

        ROOT, MANIFESTS, VERSIONS = tmp, [(claude, True), (codex, False)], vers
        before = {p: p.read_text() for p in (claude, codex, vers)}
        try:
            repin("alpha", new, "2.0.0")
        except SystemExit:
            pass
        else:
            sys.exit("selftest FAILED: repin accepted a catalog missing an entry")
        after = {p: p.read_text() for p in (claude, codex, vers)}
        if after != before:
            sys.exit("selftest FAILED: repin left a partial write after refusing")

        # Happy path: a consistent catalog writes all three.
        codex.write_text(json.dumps({"plugins": [{"name": "alpha", "source": {"sha": old}}]}) + "\n")
        MANIFESTS = [(claude, True), (codex, False)]
        repin("alpha", new, "2.0.0")
        if not (shas(claude)["alpha"] == new == shas(codex)["alpha"]):
            sys.exit("selftest FAILED: happy-path sha not written to both manifests")
        if not (versions(claude)["alpha"] == "2.0.0" == versions(vers)["alpha"]):
            sys.exit("selftest FAILED: happy-path version not written everywhere")
        print("selftest ok: repin is all-or-nothing")
    finally:
        MANIFESTS, VERSIONS, ROOT = saved
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["check"]:
        check()
    elif args == ["--all"]:
        repin_all()
    elif args == ["selftest"]:
        selftest()
    elif len(args) in (2, 3):
        repin(args[0], args[1], args[2] if len(args) == 3 else None)
    else:
        sys.exit(__doc__)
