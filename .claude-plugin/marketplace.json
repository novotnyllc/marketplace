{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "novotnyllc",
  "description": "Claude Code plugin marketplace for Claire Novotny LLC plugins.",
  "owner": {
    "name": "Claire Novotny LLC",
    "url": "https://github.com/novotnyllc"
  },
  "plugins": [
    {
      "name": "dotnet-artisan",
      "source": {
        "source": "git-subdir",
        "url": "novotnyllc/dotnet-artisan",
        "path": "plugins/dotnet-artisan"
      },
      "description": "Comprehensive .NET development skills for modern C#, ASP.NET, MAUI, Blazor, and cloud-native applications.",
      "version": "1.4.1",
      "author": {
        "name": "Claire Novotny LLC",
        "url": "https://github.com/novotnyllc"
      },
      "license": "MIT",
      "category": "development",
      "homepage": "https://github.com/novotnyllc/dotnet-artisan"
    },
    {
      "name": "agent-utilities",
      "source": {
        "source": "git-subdir",
        "url": "novotnyllc/agent-utilities",
        "path": "plugins/agent-utilities"
      },
      "description": "Agent utility skills for delivery orchestration, browser control, remote Macs, 1Password, Oracle, native profiling, and CLI design.",
      "version": "0.3.7",
      "author": {
        "name": "Claire Novotny LLC",
        "url": "https://github.com/novotnyllc"
      },
      "license": "MIT",
      "category": "productivity",
      "homepage": "https://github.com/novotnyllc/agent-utilities"
    },
    {
      "name": "tart-xcode-runner",
      "source": {
        "source": "github",
        "repo": "novotnyllc/tart-xcode-runner"
      },
      "description": "Run isolated Xcode builds and XCUITests in reusable, resettable Tart macOS VMs.",
      "version": "0.3.2",
      "author": {
        "name": "Claire Novotny LLC",
        "url": "https://github.com/novotnyllc"
      },
      "license": "MIT",
      "category": "development",
      "homepage": "https://github.com/novotnyllc/tart-xcode-runner"
    }
  ]
}
